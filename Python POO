# 3. Atributos de classe (atributos estáticos), métodos de classe e métodos estáticos

class Usuário:
    contador_usuários = 0

    def __init__(self, nome_usuário, email):
        self.nome_usuário = nome_usuário
        self.email = email
        Usuário.contador_usuários += 1
    
    def mostrar_usuário(self):
        print(f'Nome de usuário: {self.nome_usuário}.\nE-mail: {self.email}.')

    @classmethod # Decorador para criar um método que recebe automaticamente a classe como primeiro parâmetro (cls) em vez da instância (self) -> útil para herança (cls referencia a classe que chamou o método, que pode ser uma subclasse da original)
    def mostrar_registro_classmethod(cls): # Parâmetro cls (convenção para acessar a própria classe) para acessar atributos e métodos de classe diretamente dentro do método
        print(f'Usuários registrados: {cls.contador_usuários}.')
    
    # Também funciona nesse caso, em que não há herança (porém é inadequado, pois é menos flexível):
    @staticmethod # Decorador para criar um método que não recebe self nem cls automaticamente, funcionando como um método independente
    def mostrar_registro_staticmethod():
        print(f'Usuários registrados: {Usuário.contador_usuários}.')

    # Exemplo de uso apropriado para método estático (sem atributos ou métodos de instância nem de classe):
    @staticmethod
    def mensagem_despedida():
        print('Até mais! :)')

user1 = Usuário('João', 'joao@mail.com')

user1.mostrar_usuário() # Método com os atributos de instância
print(Usuário.contador_usuários) # Print com acesso direto ao atributo de classe
Usuário.mostrar_registro_classmethod() # Método de classe com o atributo estático/de classe
Usuário.mostrar_registro_staticmethod() # Método estático com o atributo estático/de classe
Usuário.mensagem_despedida() # Método estático

# II. Princípios
# 1. Encapsulamento

# Consiste em agrupar atributos e métodos em uma unidade (classe), controlando e restringindo o acesso e a modificação, para proteger a integridade dos objetos

# Exemplo sem encapsulamento
class ContaBancáriaRuim:
    def __init__(self, saldo):
        self.saldo = saldo

conta_ruim = ContaBancáriaRuim(0)

conta_ruim.saldo = -1

# Exemplo com encapsulamento
class ContaBancária:
    def __init__(self):
        self._saldo = 0 # Encapsulamento do atributo, indicando uso interno
    
    @property
    def saldo(self): # Cria uma interface pública de leitura (conta.saldo) que esconde o atributo _saldo, sem permitir sua modificação direta
        return self._saldo
    
    def depósito(self, valor): # Método controlado para acréscimos ao saldo
        if valor <= 0:
            raise ValueError('ERRO: O valor de depósito deve ser positivo.')
        self._saldo += valor

    def saque(self, valor): # Método controlado para decréscimos ao saldo
        if valor <= 0:
            raise ValueError('ERRO: O valor de saque deve ser positivo.')
        elif valor > self._saldo:
            raise ValueError('ERRO: Saldo insuficiente.')
        self._saldo -= valor

conta = ContaBancária()

conta.depósito(20)
conta.saque(10)

# 2. Abstração

# Significa ocultar detalhes internos (implementação) e mostrar apenas o necessário para o uso de um objeto (interface)

class ServiçoEmail:
    def __init__(self, usuário, senha):
        self.__usuário = usuário
        self.__senha = senha

    def _conectar(self):
        print('Conectado ao servidor.')
    
    def _autenticar(self):
        while True:
            verificação_usuário = input('Usuário: ')
            if self.__usuário == verificação_usuário:
                verificação_senha = input('Senha: ')
                if self.__senha == verificação_senha:
                    return True
                else:
                    continuar = input('Tentar novamente?').lower()
                    if continuar in ('não', 'nao', 'n'):
                        return False
            else:
                continuar = input('Tentar novamente?').lower()
                if continuar in ('não', 'nao', 'n'):
                    return False

    def enviar_email(self):
        self._conectar()
        if self._autenticar():
            print('Acesso autenticado.')
            print('E-mail enviado.')
        self._desconectar()
    
    def _desconectar(self):
        print('Desconectado do servidor.')

# Métodos _conectar, _autenticar e _desconectar foram abstraídos (ocultados do usuário da classe) -> assim, o usuário não precisa saber e executar manualmente todas as etapas necessárias para a funcionalidade desejada

email1 = ServiçoEmail('João', '123')
email1.enviar_email() # Único método público disponível

# Encapsulamento foca em agrupar atributos e métodos dentro da classe e restringir o acesso aos detalhes da implementação, definindo atributos e métodos como protegidos e/ou privados e expondo apenas uma interface controlada (os métodos públicos)
# Abstração foca em simplificar a interface para uso, ocultando as complexidades desnecessárias (para o usuário focar no objetivo da funcionalidade, ao invés de como ela funciona)

# 3. Herança

# Mecanismo que permite a uma classe (subclasse) herdar atributos e métodos de outra classe (superclasse), promovendo reutilização de código e especialização de comportamentos

class Veículo:
    def __init__(self, marca, modelo, ano): # Os veículos de todos os tipos (subclasses) herdarão os atributos da classe Veículo
        self.marca = marca
        self.modelo = modelo
        self.ano = ano
    
    def mover(self): # Os veículos de todos os tipos (subclasses) herdarão o método mover
        print(f'Destino alcançado por {self.__dict__}.') # Dicionário com todos os atributos de instância do objeto e seus valores atuais

class Carro(Veículo):
    def __init__(self, marca, modelo, ano, placa): # Sem o __init__ da subclasse, Python usaria automaticamente o __init__ da superclasse. Mas ao definir o __init__ da subclasse, ela deve receber todos os atributos da superclasse
        super().__init__(marca, modelo, ano) # Inicializa os atributos da superclasse (Python passa self automaticamente)
        self.placa = placa # Inicializa o atributo específico da subclasse Carro

class Avião(Veículo):
    def __init__(self, marca, modelo, ano, companhia):
        super().__init__(marca, modelo, ano)
        self.companhia = companhia

carro1 = Carro('Chevrolet', 'Vectra', 2000, 'ABC-1234')
avião1 = Avião('Embraer', 'E195', 2015, 'Azul')

carro1.mover() # Destino alcançado por {'marca': 'Chevrolet', 'modelo': 'Vectra', 'ano': 2000, 'placa': 'ABC-1234'}.
avião1.mover() # Destino alcançado por {'marca': 'Embraer', 'modelo': 'E195', 'ano': 2015, 'companhia': 'Azul'}.

# 4. Polimorfismo

# Uniformização do tratamento de objetos de diferentes classes, ao compartilharem uma interface comum (métodos com o mesmo nome)

# Exemplo sem polimorfismo
class Carro:
    def __init__(self, marca, modelo, ano, placa):
        self.marca = marca
        self.modelo = modelo
        self.ano = ano
        self.placa = placa
    
    def mover_carro(self):
        print('O carro alcançou o destino.')

class Avião:
    def __init__(self, marca, modelo, ano, companhia):
        self.marca = marca
        self.modelo = modelo
        self.ano = ano
        self.companhia = companhia

    def mover_avião(self):
        print('O avião alcançou o destino.')

veículos = [
    Carro('Chevrolet', 'Vectra', 2000, 'ABC-1234'),
    Avião('Embraer', 'E195', 2015, 'Azul')
]

# Não há consistência entre as classes Carro e Avião, portanto é necessário checar todas as possibilidades de classes antes de acessar os atributos e métodos dos objetos:
for veículo in veículos:
    if isinstance(veículo, Carro):
        print(f'Inspecionando um {type(veículo).__name__}:\n{veículo.marca} - {veículo.modelo}.')
        veículo.mover_carro()
    elif isinstance(veículo, Avião):
        print(f'Inspecionando um {type(veículo).__name__}:\n{veículo.marca} - {veículo.modelo}.')
        veículo.mover_avião()
    else:
        raise Exception('O objeto não é um veículo válido.')

# Exemplo com polimorfismo
class Veículo:
    def __init__(self, marca, modelo, ano):
        self.marca = marca
        self.modelo = modelo
        self.ano = ano
    
    def mover(self): # Método que define a interface comum que todas as subclasses devem seguir para garantir o polimorfismo. Também funciona como comportamento padrão, caso uma subclasse não sobrescreva esse método
        print('O veículo alcançou o destino.') # {type(self).__name__.lower()} poderia substituir "veículo" para exibir mensagens personalizadas para cada tipo de veículo

class Carro(Veículo):
    def __init__(self, marca, modelo, ano, placa):
        super().__init__(marca, modelo, ano)
        self.placa = placa
    
    def mover(self): # Método mover redefinido especificamente para a classe Carro
        print(f'O carro alcançou o destino.')

class Avião(Veículo):
    def __init__(self, marca, modelo, ano, companhia):
        super().__init__(marca, modelo, ano)
        self.companhia = companhia
    
    def mover(self): # Método mover redefinido especificamente para a classe Avião
        print(f'O avião alcançou o destino.')

veículos: list[Veículo] = [
    Carro('Chevrolet', 'Vectra', 2000, 'ABC-1234'),
    Avião('Embraer', 'E195', 2015, 'Azul')
]

for veículo in veículos:
    print(f'Inspecionando {type(veículo).__name__}:\n{veículo.marca}; {veículo.modelo}; {veículo.ano}.')
    veículo.mover() # Um método de nome padronizado e com comportamentos específicos pode ser chamado em objetos diferentes
