# Classe Cachorro, com atributos nome e dono (que recebe uma instância da classe Dono), e métodos latir() e exibir_informações()
class Cachorro:
    def __init__(self, nome, dono):
        self.nome = nome.strip().capitalize()
        self.dono = dono
    
    def latir(self):
        if self.nome != 'Sebastian':
            print(f'{self.nome}: Au! Au!')
        else:
            print('Sebastian: Auuu!')
    
    def exibir_informações(self):
        print(f'Nome do cachorro: {self.nome};\nNome do dono: {self.dono.nome_dono};\nBairro: {self.dono.bairro}.')
        # self.nome acessa o atributo nome do objeto atual da classe Cachorro
        # "dot notation" (notação de ponto) = acesso a atributos e métodos de um objeto com . entre o nome do objeto e o nome do atributo ou método:
        # self.dono.nome_dono acessa o atributo nome_dono da classe Dono, pelo atributo dono da classe Cachorro
        # self.dono.bairro acessa o atributo bairro da classe Dono, pelo atributo dono da classe Cachorro

class Dono:
    def __init__(self, nome_dono, bairro):
        self.nome_dono = nome_dono.strip().capitalize()
        self.bairro = bairro.strip().capitalize()

# Objetos/instâncias da classe Dono
dono_1 = Dono('Marcelo', 'Esplanada')
dono_2 = Dono('Adriana', 'Santa Efigênia')
# Objetos/instâncias da classe Cachorro
cachorro_1 = Cachorro('Prince', dono_1) # O atributo dono da instância cachorro_1 aponta para o objeto dono_1
cachorro_2 = Cachorro('Sebastian', dono_2) # O atributo dono da instância cachorro_2 aponta para o objeto dono_2

# dot notation:
cachorro_1.exibir_informações()
cachorro_1.latir()
cachorro_2.exibir_informações()
cachorro_2.latir()
print(f'Acesso direto ao atributo bairro do objeto dono_1 da classe Dono, que é valor do atributo dono do objeto cachorro_1 da classe Cachorro: {cachorro_1.dono.bairro}.') # cachorro_1.dono acessa o argumento dono_1 em Cachorro('Prince', dono_1), que é o objeto Dono('Marcelo', 'Esplanada') e .bairro acessa 'Esplanada' (objeto_maior.objeto_menor.atributo_do_objeto_menor)

'''
Definições:
    • Classe: estrutura que define os atributos (dados) e métodos (comportamentos) de objetos
    • Objeto: instância de uma classe
    • Atributo: variável que armazena informação da classe (atributo de classe) ou de um objeto (atributos de instância), quando criados dentro de qualquer método da classe (principalmente __init__), a partir de self.
    • Método: função de objetos
        o __init__ (em def __init__(self):): “método construtor”, método especial da classe, inicializa os atributos do objeto (chamado automaticamente quando um objeto é criado)
        o self (em def método(self):): parâmetro que recebe automaticamente a instância como argumento. Representa a própria instância (referência ao objeto atual), usado para acessar atributos e métodos de um objeto. Em self.atributo ou self.método(), self é o próprio objeto, através do qual se acessa um atributo ou um método
'''
