# 31) Crie um jogo de JoKenPo (Pedra-Papel-Tesoura)
import random

def JoKenPo():
    while True:
        jogada_Player = input("Faça sua jogada!").strip().lower()
        jogada_NPC = random.choice(["pedra", "papel", "tesoura"])
        if ((jogada_Player == "pedra" and jogada_NPC == "tesoura") or
            (jogada_Player == "papel" and jogada_NPC == "pedra") or
            (jogada_Player == "tesoura" and jogada_NPC == "papel")):
            print(jogada_NPC)
            print("Venceu!")
        elif ((jogada_NPC == "pedra" and jogada_Player == "tesoura") or
            (jogada_NPC == "papel" and jogada_Player == "pedra") or
            (jogada_NPC == "tesoura" and jogada_Player == "papel")):
            print(jogada_NPC)
            print("Perdeu!")
        elif jogada_NPC == jogada_Player:
            print(jogada_NPC)
            print("Empate!")
        else:
            print("Jogada não entendida, escreva de novo!")
            continue
        repetir = input("Quer tentar de novo?").strip().lower()
        if repetir == "não":
            break

JoKenPo()

