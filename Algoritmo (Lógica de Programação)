    tinta = área / 2
    print(f"Área a ser pintada: {área:.3f} metros².\n"
        f"Tinta necessária: {tinta:.2f} litros.\n"
        f"Sobra recomendada: {tinta / 5:.2f} litros")

área_tinta()

