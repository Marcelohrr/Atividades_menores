# 37) Escreva um programa que leia um número inteiro qualquer e peça para o usuário escolher qual será a base de conversão (1 para binário, 2 para octal e 3 para hexadecimal)
def conversor_numérico():
    n = int(input('Insira o número para conversão: '))
    escolha_base = int(input('Escolha a conversão desejada: 1 = binário, 2 = octal, 3 = hexadecimal.'))
    if escolha_base == 1:
        binário = []
        variável = n
        while variável != 0:
            binário.insert(0, variável % 2)
            variável //= 2
        b = int(''.join(str(x) for x in binário))
        print(f'O número {n} convertido para binário é {b}.')
    elif escolha_base == 2:
        octal = []
        variável = n
        while variável != 0:
            octal.insert(0, variável % 8)
            variável //= 8
        o = int(''.join(str(x) for x in octal))
        print(f'O número {n} convertido para octal é {o}.')
    elif escolha_base == 3:
        hexadecimal = []
        variável = n
        while variável != 0:
            hexadecimal.insert(0, variável % 16)
            variável //= 16
        letras = 'ABCDEF'
        hexadecimal_letras = []
        for i in hexadecimal:
            if i >= 10:
                hexadecimal_letras.append(letras[i - 10])
            else:
                hexadecimal_letras.append(i)
        h = ''.join(str(x) for x in hexadecimal_letras)
        print(f'O número {n} convertido para hexadecimal é {h}.')
    else:
        print('Digite uma conversão corretamente.')

conversor_numérico()

