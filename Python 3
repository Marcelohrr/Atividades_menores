# B) Com while
def caixa_eletrônico():
    v = int(input('Valor a ser sacado: '))
    notas = [200, 100, 50, 20, 10, 5, 2]
    contador = 0
    sequência = []
    print(f'Serão entregues:')
    while contador <= 6:
        if contador == 5:
            if (v % 5) % 2 == 0:
                sequência.append(v // notas[contador])
                print(f'{sequência[contador]} cédulas de R${notas[contador]}')
                v %= notas[contador]
            else:
                sequência.append(0)
                print(f'{sequência[contador]} cédulas de R${notas[contador]}')
        else:
            sequência.append(v // notas[contador])
            print(f'{sequência[contador]} cédulas de R${notas[contador]}')
            v %= notas[contador]
        contador += 1

caixa_eletrônico()
