# 23) Faça um programa que leia um número de 0 a 9999 e mostre na tela cada um dos dígitos separados
# A) Como string
n = input('Dê um número de 0 a 9999: ').zfill(4)
print(n[0], n[1], n[2], n[3])

# B) Matematicamente
n = int(input('Dê um número de 0 a 9999: '))
print(f'O número {n} possui {n // 1000} na casa dos milhares, {(n % 1000) // 100} na das centenas, {(n % 100) // 10} na das dezenas e {n % 10} na das unidades.')

