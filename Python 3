# 17) Faça um programa que leia o comprimento do cateto oposto e do cateto adjacente de um triângulo retângulo, calcule e mostre o comprimento da hipotenusa
# A) Sem import math
co = float(input('Insira o cateto oposto: '))
ca = float(input('Insira o cateto adjacente: '))
h = (co ** 2 + ca ** 2) ** 0.5

print(f'A hipotenusa é {h}.')

# B) Com import hypot
from math import hypot

co = float(input('Insira o cateto oposto: '))
ca = float(input('Insira o cateto adjacente: '))
h = hypot(co, ca)

print(f'A hipotenusa é {h}.')

# 18) Faça um programa que leia um ângulo qualquer e mostre na tela o valor do seno, cosseno e tangente desse ângulo
from math import sin, cos, tan, radians

ângulo = float(input('Digite um ângulo em graus sexagesimais: '))
s = sin(radians(ângulo))
c = cos(radians(ângulo))
t = tan(radians(ângulo))

print(f'O seno, cosseno e tangente de {ângulo} graus são, respectivamente: {s}, {c} e {t}.')

