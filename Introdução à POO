# Exemplo do vídeo "Programação Orientada a Objetos | Explicação Simples" (Dobra de Bits, 2023)

# Programação procedural:

def comer(comida):
    comida = comida - 1
    return comida

def dormir():
    sono = False
    return sono

nome_cachorro_1 = 'Prince'
comida_cachorro_1 = 3
sono_cachorro_1 = False

nome_cachorro_2 = 'Sebastian'
comida_cachorro_2 = 1
sono_cachorro_2 = True

# Colocando o Prince para comer
comida_cachorro_1 = comer(comida_cachorro_1)
# Colocando o Sebastian para dormir
sono_cachorro_2 = dormir()

# Programação Orientada a Objetos:
# Classe de nome Cachorro, com atributos nome, comida, sono e quer_brincar, e métodos comer(), dormir() e exibir_situação()
class Cachorro:
    def __init__(self, nome, comida, sono, quer_brincar): # Método construtor, serve para inicializar os atributos do objeto (chamado automaticamente quando um objeto é criado na classe)
        self.nome = nome
        self.comida = comida
        self.sono = sono
        self.quer_brincar = quer_brincar
    
    def comer(self):
        self.comida -= 1
    
    def dormir(self):
        self.sono = False
    
    def exibir_situação(self):
        print(f'Situação de {self.nome}:\n- Ração: {self.comida};\n- Sono: {self.sono};\n- Quer brincar: {self.quer_brincar}.')

# Instâncias cachorro_1 e cachorro_2, da classe Cachorro
cachorro_1 = Cachorro('Prince', 3, False, True)
cachorro_2 = Cachorro('Sebastian', 1, True, False)

cachorro_1.comer()
cachorro_2.dormir()
cachorro_1.exibir_situação(); cachorro_2.exibir_situação()
