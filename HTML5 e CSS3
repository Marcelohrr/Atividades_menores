<!DOCTYPE html> <!-- Declaração simplificada do tipo de documento - por padrão, os navegadores entendem como HTML5 -->
<html lang="pt-br"> <!-- Definição do idioma -->
<head> <!-- Cabeçalho do documento, com metadados e informações gerais -->
    <meta charset="UTF-8"> <!-- Define a codificação de caracteres como UTF-8 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Configura a viewport para responsividade em dispositivos móveis -->
    <link rel="shortcut icon" href="imagens/favicon.ico" type="image/x-icon"> <!-- relationship = indica para que serve o recurso que você está vinculando; hypertext reference = define o caminho do arquivo; type = tipo MIME do arquivo (seu formato, informa ao navegador como interpretá-lo) -->
    <title>Exercícios HTML</title> <!-- Título da página, mostrado na aba do navegador -->
    <style> /* CSS interno */
        body {
            background-color: rgb(234, 212, 255);
        }
        mark {
            background-color: rgb(91, 255, 113);
        }
    </style>
</head>
<body> <!-- Corpo do documento, onde fica o conteúdo visível -->
