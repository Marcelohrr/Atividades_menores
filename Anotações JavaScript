fetch(`https://viacep.com.br/ws/30280070/json/`)
    .then(mensagemSucesso => {
        if (!mensagemSucesso.ok) { // A propriedade .ok verifica se uma requisição foi feita com sucesso (usada para tratar o erro de status de servidor)
            throw new Error('erro na requisição (' + mensagemSucesso.status + ')'); // Se executado, pula direto para o .catch()
        }
        return mensagemSucesso.json(); // .json() lê o corpo da resposta (que ainda é um objeto HTTP), converte JSON → objeto JS e retorna outra Promise. Usa-se .json() para fetch (HTTP) — converte resposta da API em objeto JS — e JSON.parse() para strings JSON "puras" fora do fetch — localStorage, arquivos, texto, etc.
    })
    .then(dado => {
        console.log(dado);
    })
    .catch(erro => { // Erro de requisição com servidor, tratado com o método .catch()
        console.log('Erro: ' + erro.message);
    });

