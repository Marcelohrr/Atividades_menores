// Programação assíncrona

/*
When dealing with simple types in JavaScript, our code executes sequentially — everything is nice and simple. However, when writing a real world code, we often make calls to databases, open files and speak to remote APIs over the internet. Now running tasks like this will usually not return the results straight away, they will rather return a Promise (object that represents the eventual completion or failure of an asynchronous operation and its resulting value).
*/

promessa.then((resultado) => { }); // Handle fulfilled (resolved) promises. .then() is called when the task completes; receives the result of the task as a parameter
promessa.catch((erro) => { }); // Handle failed (rejected) promises. .catch() is called if anything goes wrong while processing our request; receives the error that occurred as a parameter

const axiosRequest = require('axios'); // require() carrega um módulo. Axios é uma biblioteca para fazer requisições HTTP

axiosRequest
    .get('https://www.boredapi.com/api/activity') // To simulate an error: 'https://httpstat.us/500'
    .then(resposta => {
        console.log(`You could ${resposta.data.activity}`);
    })
    .catch(erro => {
        console.error(`ERROR! ${erro}`);
    });

/*
This works fine, however the code isn't particularly nice to look at, and if you have a lot of complicated code inside your methods, things will soon start to get quite unwieldy. So what we need really is a way of receiving the results of our promises sequentially. And this is where the await operator comes in. It allows us to wait until the promise has completed before moving on to the next line. Can only be used inside an async function.
*/

const axiosRequest = require('axios'); // require() carrega um módulo. Axios é uma biblioteca para fazer requisições HTTP

async function sugerirAtividade() {
    try {
        let resposta = await axiosRequest.get('https://www.boredapi.com/api/activity');
        console.log(`You could ${resposta.data.activity}`);
    } catch (erro) {
        console.error(`ERROR! ${erro}`);
    }
}

