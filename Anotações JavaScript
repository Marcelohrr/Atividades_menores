/*
How to fetch data from a JSON file (sending an HTTP GET request) and display the response in the browser:

{
    "pessoas": [
        {
            "nome": "Efigênia",
            "idade": 1
        },
        {
            "nome": "Beto",
            "idade": 2
        },
        {
            "nome": "João",
            "idade": 3
        }
    ]
}
*/
async function carregarPessoas() { // Função assíncrona para buscar e exibir os dados
    try {
        const resposta = await fetch('people.json'); // Faz a requisição HTTP para o arquivo JSON; fetch retorna uma Promise com a resposta da requisição

        if (!resposta.ok) {
            throw new Error('Erro na requisição: ' + resposta.status); // Verifica se a resposta foi bem-sucedida (status 200–299)
        }

        const dadosJSON = await resposta.json(); // Converte a resposta de string JSON para objeto JavaScript (faz o parse internamente)

        const pessoas = dadosJSON.pessoas; // Acessa o array de pessoas dentro do objeto JSON

        let output = '';

        for (let i = 0; i < pessoas.length; i++) {
            output += `<li>${pessoas[i].nome}</li>`;
        }

        document.getElementById('pessoas').innerHTML = output;

    } catch (error) {
        console.error('Erro ao carregar os dados:', error);
    }
}

carregarPessoas();

