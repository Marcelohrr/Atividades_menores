// Arrow functions

/*
Arrow functions are a concise way to write function expressions, good for simple functions that you use only once.

Formula: (parameters) => code
*/

// 1. Diferença entre Function expression e Arrow function:

darOi();

function darOi() { // Declaração da função com nome próprio oi. O identificador oi é hoisted (elevado) com inicialização completa durante a fase de criação (que antecede a execução), permitindo uso antes da declaração
    console.log('Oi!');
}

const darOla = () => console.log('Olá!'); // Declaração da variável ola, que recebe uma função anônima. A variável é hoisted na fase de criação, mas permanece em estado de Temporal Dead Zone (TDZ) até ser inicializada durante a execução; portanto a atribuição deve anteceder seu uso

// Regra: com apenas uma expressão e sem chaves, o resultado da expressão é retornado implicitamente; com bloco de código, entre chaves, é necessário explicitar o return

darOla();

