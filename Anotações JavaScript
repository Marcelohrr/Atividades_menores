// Promise is a object with one of three states: pending, fulfilled, rejected. Most commonly useful to network requests.

const promessa1 = new Promise((resolver, rejeitar) => {}); // Promise constructor takes an executor function with the functions resolve and reject as parameters

console.log(promessa1); // Promise { <pending> }

const promessa2 = new Promise((resolver, rejeitar) => {
    resolver(10);
});

console.log(promessa2); // Promise { 10 }

// But we don't know always when exactly our promises are going to settle (change states from pending to either fulfilled or rejected)

const promessa3 = new Promise((resolver, rejeitar) => {
    setTimeout(() => {
        resolver('Aa');
    }, 1000);
});

promessa3.then(valor => { // What this is saying is: take this promise and when it resolves, then, run this function. .then() pode receber dois callbacks como parâmetros: onFulfilled, onRejected.
    console.log(valor); // Aa
}); // Simplificação: promessa3.then(console.log);

const promessa4 = new Promise((resolver, rejeitar) => {
    setTimeout(() => {
        rejeitar(new Error('Something went wrong.'));
    }, 1000);
});

promessa4.then(valor => {
    console.log(valor); // onFulfilled
}, erro => {
    console.log('Oh no! ' + erro); // onRejected
}); // Simplificação: promessa4.then(console.log, erro => console.log('Oh no! ' + erro)); ou promessa4.then(console.log, erro => console.log('Oh no! ' + erro.message));

// What most people prefer:
promessa4.then(console.log).catch(erro => console.log('Oh no! ' + erro.message));

const promessa5 = new Promise((resolver, rejeitar) => {
    setTimeout(() => {
        resolver(10);
    }, 1000);
});

// .catch() is a function of whatever .then() returned. And .then() returns a Promise. So it's possible to do "then chains" (it's the original way to handle promises):
promessa5
    .then(valor => valor * 2) // 10 * 2
    .then(console.log) // 20
    .catch(erro => { // A promessa5 resolve, portanto não executa .catch()
        console.log('Erro: ' + erro.message);
        return 100;
    })
    .then(console.log) // undefined (que o console.log retornou, já que o .catch() não foi executado)
    .finally(() => {
        console.log('Feito!'); // Happens regardless of if this promise was resolved or rejected
    });
// New way (with async and await), ao invés de promessa5.then(console.log):
async function logPromessa5() {
    const resultado = await promessa5;
    console.log(resultado);
}
logPromessa5();
/*
If the function rejects, ao invés de:
async function logPromessa4() {
    const resultado = await promessa4;
    console.log(resultado);
}
logPromessa4().catch(erro => console.log('Oh no! ' + erro.message));

We can use try/catch:
*/
async function logPromessa4() {
    try {
        const resultado = await promessa4;
        console.log(resultado);
    } catch (erro) {
        console.log('Oh no! ' + erro.message);
    }
}

// Promise object functions

const promessa6 = Promise.resolve(123); // Non pending promise. Also: Promise.reject()
console.log(promessa6); // 123

const all1 = Promise.all([ // Promise.all([]) waits for all promises to fulfill and rejects immediately if one rejects
    new Promise((resolver, rejeitar) => setTimeout(() => resolver(1), 1000)),
    Promise.resolve(2)
]);

console.log(all1) // Promise { <pending> }
all1.then(console.log) // [ 1, 2 ] — if one of the promises rejects, Promise.all rejects immediately (fail-fast) and skips this .then(), going to .catch() instead

const all2 = Promise.allSettled([ // Promise.allSettled([]) waits for all of the promises to settle, regardless of if they reject
    new Promise((resolver, rejeitar) => setTimeout(() => resolver(1), 1000)),
    Promise.reject(2)
]);

all2.then(console.log) // [ { status: 'fulfilled', value: 1 }, { status: 'rejected', reason: 2 } ]

const all3 = Promise.race([ // Promise.race([]) resolve ou rejeita com o resultado da primeira promise que se estabelecer
    new Promise((resolver, rejeitar) => setTimeout(() => resolver(1), 1000)),
    Promise.resolve(2)
]);

all3.then(console.log) // 2

const all4 = Promise.any([ // Promise.any([]) ignora rejeições e retorna a primeira promise que resolver
    new Promise((resolver, rejeitar) => setTimeout(() => resolver(1), 1000)),
    Promise.reject(2)
]);

all4.then(console.log) // 1

// Common pattern ("deferred pattern") with promises — para expor as funções de resolução da promise (resolve e reject) para fora do escopo do executor da Promise:
let resolveExterno, rejectExterno;
const promise1 = new Promise((resolve, reject) => {
    resolveExterno = resolve;
    rejectExterno = reject;
});
//New way to do this (doesn't have amazing support across browsers):
const { promise: promise2, resolve, reject } = Promise.withResolvers();
console.log(promise2); // Promise { <pending> }
resolve(1);
promise2.then(console.log); // 1

